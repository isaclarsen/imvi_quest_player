# Unity generated folders
/Library/
/Temp/
/Obj/
/Logs/
/UserSettings/
/MemoryCaptures/

# Unity build caches and temporary Android output
/.utmp/
/ExportedObj/
/BuildPlayerData/

# Build outputs
/Build/
/Builds/*
!/Builds/.gitkeep
*.apk
*.aab
*.unitypackage
*.symbols.zip
*.mapping

# Autogenerated IDE/project files
*.csproj
*.sln
*.slnx
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Visual Studio / Rider / VS Code local state
.vs/
.vscode/
.idea/
*.suo
*.tmp
*.tmp_proj

# OS files
.DS_Store
Thumbs.db
Desktop.ini

# Unity crash/recovery state
/Assets/_Recovery/
/Assets/_Recovery.meta

# Local tool artifacts that should not be part of the Unity handover
/.github/java-upgrade/
/.github/appmod/
